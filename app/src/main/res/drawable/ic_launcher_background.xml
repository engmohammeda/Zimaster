<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon BACKGROUND layer (108x108dp).

  A warm terracotta->sienna diagonal gradient with a soft radial highlight in
  the upper-left, so the tile reads with depth instead of looking flat. The
  whole 108x108 area is painted because launchers mask it down to 72x72.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base diagonal gradient -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF7A52" />
                <item android:offset="0.48" android:color="#E2603C" />
                <item android:offset="1.0" android:color="#AE3520" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft light bloom, upper-left: gives the tile a lit, three-dimensional feel -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="33"
                android:centerY="27"
                android:gradientRadius="74">
                <item android:offset="0.0" android:color="#4DFFD9B0" />
                <item android:offset="0.55" android:color="#14FFC9A0" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle vignette, lower-right: anchors the icon and adds contrast under the Z -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="92"
                android:gradientRadius="62">
                <item android:offset="0.0" android:color="#38000000" />
                <item android:offset="0.6" android:color="#12000000" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
