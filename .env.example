# ═══════════════════════════════════════════════════════════════════════════
# Zimaster — environment template for the admin / CLI scripts
#
#   cp .env.example .env      then fill in the values below.
#   .env is git-ignored — never commit it.
#
# These are only needed for the local tooling (upload_lessons.py,
# tools/migrate_firestore_to_supabase.py, the Supabase CLI). The Android app
# itself reads SUPABASE_URL / SUPABASE_ANON_KEY at build time from
# gradle.properties or local.properties — see docs/SUPABASE_SETUP.md.
#
# Project ref: eduobulbcwgcjruzphgc
# ═══════════════════════════════════════════════════════════════════════════

# ── Public (safe to share — RLS still applies to every request) ─────────────
SUPABASE_URL=https://eduobulbcwgcjruzphgc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_rc4aCFLVYRfvvWqMfS2VXg_k4MvTP0V
SUPABASE_PROJECT_REF=eduobulbcwgcjruzphgc

# ── SECRET — never commit, never ship inside the APK ────────────────────────

# Bypasses Row Level Security entirely. Only the admin scripts may use it.
# Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Password for the `postgres` database user. Used by `supabase link`,
# `supabase db push` and the nightly pg_dump backup workflow.
# Dashboard → Project Settings → Database → Database password.
SUPABASE_DB_PASSWORD=

# Personal access token for the Supabase CLI / Management API.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection string (built from the two values above).
# Port 5432 = direct connection; use 6543 for the transaction pooler.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.eduobulbcwgcjruzphgc.supabase.co:5432/postgres

# ── Optional: Telegram release notifications (android-release.yml) ──────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
