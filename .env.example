# Zimaster — Supabase environment template
# انسخ هذا الملف إلى `.env` وعبّئ القيم الحقيقية (ولا تُدخله في Git أبداً):
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# Cloud project (safe to share — also committed in gradle.properties)
SUPABASE_URL=https://eduobulbcwgcjruzphgc.supabase.co
SUPABASE_PROJECT_REF=eduobulbcwgcjruzphgc
SUPABASE_ANON_KEY=sb_publishable_rc4aCFLVYRfvvWqMfS2VXg_k4MvTP0V

# ── أسرار الخادم: لا تُدخلها في Git ولا في التطبيق ──
# المفتاح السرّي (يبدأ بـ sb_secret_) من:
# Supabase Dashboard → Project Settings → API → Secret key
# مطلوب لسكربتات الإدارة: upload_lessons.py و tools/migrate_firestore_to_supabase.py
SUPABASE_SERVICE_ROLE_KEY=sb_secret_PASTE_YOUR_SECRET_KEY_HERE

# كلمة سر قاعدة البيانات (postgres) من:
# Supabase Dashboard → Project Settings → Database → Database password
# مطلوبة للاتصال المباشر وسير النسخ الاحتياطي (SUPABASE_DB_PASSWORD في GitHub Secrets)
SUPABASE_DB_PASSWORD=PASTE_YOUR_DB_PASSWORD_HERE

# رمز الوصول الشخصي للـ CLI من: https://supabase.com/dashboard/account/tokens
# مطلوب لسير ترحيلات قاعدة البيانات (SUPABASE_ACCESS_TOKEN في GitHub Secrets)
SUPABASE_ACCESS_TOKEN=PASTE_YOUR_ACCESS_TOKEN_HERE
