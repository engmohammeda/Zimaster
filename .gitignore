# ============ Android / Gradle ============
*.iml
.gradle/
**/build/
local.properties
.kotlin/

# ============ Android Studio / IDE ============
.idea/
.DS_Store
/captures
.externalNativeBuild/
.cxx/

# ============ Signing material — NEVER in the repo ============
*.jks
*.keystore

# ============ Misc ============
*.hprof
upload_tool/__pycache__/
__pycache__/

# ============ Firebase secrets — NEVER in the repo ============
# Admin SDK service account keys (used by upload_lessons.py or manual CLI
# deploys). GitHub Actions uses the FIREBASE_SERVICE_ACCOUNT repo secret
# instead — see docs/FIREBASE_SETUP.md §4.
serviceAccountKey.json
firebase-service-account*.json
*-firebase-adminsdk-*.json

# ============ Supabase — NEVER in the repo ============
# Local environment for the admin/CLI scripts. Copy .env.example → .env.
.env
.env.*
!.env.example

# Supabase CLI scratch space: `supabase link` writes the project ref and a
# short-lived access token cache here. Regenerated on demand.
supabase/.temp/
supabase/.branches/

# Service-role / secret keys in any stray local file shape.
*service_role*key*
sb_secret_*
